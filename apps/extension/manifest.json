{
  "manifest_version": 3,
  "name": "Mull",
  "version": "0.0.1",
  "description": "Opal for AI. Catches lazy prompts to ChatGPT, Claude, and Gemini and makes you pass a short quiz on the concept before the answer comes through. No telemetry, keys stay on your device.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Mull" },
  "options_page": "options.html"
}
